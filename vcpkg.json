{
  "$schema": "https://raw.githubusercontent.com/microsoft/vcpkg-tool/main/docs/vcpkg.schema.json",
  "name": "shiftdrop",
  "version": "0.5.0",
  "description": "ShiftDrop: drag a file, press a modifier, drop it on a radial menu to convert it. Offline.",
  "dependencies": [
    "wil",
    "sqlite3",
    "nlohmann-json",
    "libwebp",
    "qpdf",
    "zlib",
    {
      "name": "libavif",
      "default-features": false,
      "features": [ "aom", "dav1d" ]
    },
    "lunasvg",
    "miniz",
    "pugixml",
    "md4c",
    { "name": "libarchive", "default-features": false, "features": [ "bzip2", "lzma", "zstd" ] },
    "gtest"
  ],
  "vcpkg-configuration": {
    "overlay-triplets": [ "./triplets" ]
  },
  "builtin-baseline": "9e593bb18ea69cc5095e012465dcd675a822ed0d"
}
