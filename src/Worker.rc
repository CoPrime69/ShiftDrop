// ShiftDropWorker.exe's version resource, so every program ShiftDrop installs states the same product
// name and version (signing checks both). Its version is the app's (Version.h, generated from VERSION),
// so scripts/check-version.ps1 agrees.
#include <windows.h>
#include "Version.h"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION SD_FILEVERSION
 PRODUCTVERSION SD_FILEVERSION
 FILEFLAGSMASK 0x3fL
 FILEFLAGS SD_FILEFLAGS
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "ShiftDrop"
            VALUE "FileDescription", "ShiftDrop Worker - reads archives in a sandbox"
            VALUE "FileVersion", SD_FILEVERSION_A
            VALUE "InternalName", "ShiftDropWorker"
            VALUE "OriginalFilename", "ShiftDropWorker.exe"
            VALUE "ProductName", "ShiftDrop"
            VALUE "ProductVersion", SD_VERSION_A
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
