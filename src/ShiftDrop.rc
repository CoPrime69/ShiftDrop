// The manifest is embedded by the linker (see CMakeLists.txt), not here, to avoid a duplicate RT_MANIFEST.
#include <windows.h>
#include "resource.h"

IDI_APPICON ICON "ShiftDrop.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 0,3,1,0
 PRODUCTVERSION 0,3,1,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "ShiftDrop"
            VALUE "FileDescription", "ShiftDrop - drag, press a key, drop to convert"
            VALUE "FileVersion", "0.3.1.0"
            VALUE "InternalName", "ShiftDrop"
            VALUE "OriginalFilename", "ShiftDrop.exe"
            VALUE "ProductName", "ShiftDrop"
            VALUE "ProductVersion", "0.3.1.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
