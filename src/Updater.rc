// ShiftDrop-Updater.exe's resources. Its manifest (app.manifest, embedded by the linker) asks for no
// elevation: without one, Windows would treat an exe named "...Updater" as an installer and prompt.
// Its version is the app's (Version.h, generated from VERSION), so scripts/check-version.ps1 agrees.
#include <windows.h>
#include "resource.h"
#include "Version.h"

IDI_APPICON ICON "ShiftDrop.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION SD_FILEVERSION
 PRODUCTVERSION SD_FILEVERSION
 FILEFLAGSMASK 0x3fL
 FILEFLAGS SD_FILEFLAGS
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "ShiftDrop"
            VALUE "FileDescription", "ShiftDrop Updater - checks for and installs new versions"
            VALUE "FileVersion", SD_FILEVERSION_A
            VALUE "InternalName", "ShiftDrop-Updater"
            VALUE "OriginalFilename", "ShiftDrop-Updater.exe"
            VALUE "ProductName", "ShiftDrop"
            VALUE "ProductVersion", SD_VERSION_A
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
