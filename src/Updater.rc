// ShiftDrop-Updater.exe's resources. Its manifest (app.manifest, embedded by the linker) asks for no
// elevation: without one, Windows would treat an exe named "...Updater" as an installer and prompt.
// The version numbers come from CMake (the project's version), as the app's do.
#include <windows.h>
#include "resource.h"

IDI_APPICON ICON "ShiftDrop.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION SD_VERSION_MAJOR,SD_VERSION_MINOR,SD_VERSION_PATCH,0
 PRODUCTVERSION SD_VERSION_MAJOR,SD_VERSION_MINOR,SD_VERSION_PATCH,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "ShiftDrop"
            VALUE "FileDescription", "ShiftDrop Updater - checks for and installs new versions"
            VALUE "InternalName", "ShiftDrop-Updater"
            VALUE "OriginalFilename", "ShiftDrop-Updater.exe"
            VALUE "ProductName", "ShiftDrop"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
